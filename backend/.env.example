# Copy this file to .env and fill in your Groq API key.
# Get a key at https://console.groq.com

GROQ_API_KEY=your_groq_api_key_here
GROQ_EXTRACTION_MODEL=gemma2-9b-it
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# SQLite by default (zero setup). Swap for Postgres/MySQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/complaints
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/complaints
DATABASE_URL=sqlite:///./complaints.db
